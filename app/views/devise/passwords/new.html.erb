<div class="w-full max-w-sm mx-auto">
  <h1 class="text-2xl sm:text-3xl font-semibold text-stone-900 mb-6"><%= t(".forgot_your_password") %></h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "card p-6 grid gap-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
    </div>

    <%= f.submit t(".send_me_reset_password_instructions"), class: "btn btn-primary w-full" %>
  <% end %>

  <div class="mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
