<div class="w-full max-w-sm mx-auto">
  <h1 class="text-2xl sm:text-3xl font-semibold text-ink-900 mb-2"><%= t(".sign_up") %></h1>
  <p class="text-sm text-ink-500 mb-6"><%= t(".explanation") %></p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "card p-6 grid gap-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :name, class: "field-label" %>
      <%= f.text_field :name, autofocus: true, class: "field-input" %>
    </div>

    <div>
      <%= f.label :email, class: "field-label" %>
      <%= f.email_field :email, autocomplete: "email", class: "field-input" %>
    </div>

    <div>
      <%= f.label :phone, class: "field-label" %>
      <%= f.telephone_field :phone, class: "field-input" %>
    </div>

    <div>
      <%= f.label :whatsapp, class: "field-label" %>
      <%= f.telephone_field :whatsapp, class: "field-input" %>
    </div>

    <div>
      <%= f.label :bio, class: "field-label" %>
      <%= f.text_area :bio, rows: 3, class: "field-input" %>
    </div>

    <div>
      <%= f.label :password, class: "field-label" %>
      <% if @minimum_password_length %>
        <p class="field-hint -mt-1 mb-1"><%= t(".minimum_password_length", count: @minimum_password_length) %></p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "field-input" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
    </div>

    <%= f.submit t(".sign_up"), class: "btn btn-primary w-full" %>
  <% end %>

  <div class="mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
