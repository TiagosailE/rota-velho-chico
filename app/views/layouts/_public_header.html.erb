<header class="border-b border-ink-200 bg-white/90 backdrop-blur sticky top-0 z-10">
  <div class="container mx-auto px-5 py-4 flex flex-wrap items-center justify-between gap-3">
    <%= link_to tours_path, class: "font-display text-xl font-semibold text-ink-900 hover:text-brand-700 transition-colors" do %>
      Rota Velho Chico
    <% end %>

    <nav class="text-sm flex items-center gap-4 text-ink-600">
      <%= link_to t("layout.nav.tours"), tours_path, class: "font-medium text-ink-700 hover:text-brand-700" %>
      <%= link_to t("layout.nav.my_booking"), new_booking_lookup_path, class: "font-medium text-ink-700 hover:text-brand-700" %>

      <%# Operador ja autenticado precisa de acesso rapido ao painel --
          isso continua no topo. Quem nao esta logado nao ve "Area do
          operador" aqui: esse link vive so no rodape, pro visitante nao
          confundir a ferramenta do operador com o site publico. %>
      <% if operator_signed_in? %>
        <span aria-hidden="true" class="text-ink-300">|</span>
        <span class="hidden sm:inline"><%= t("operators.nav.signed_in_as", name: current_operator.name) %></span>
        <%= link_to t("operators.nav.panel"), operators_root_path, class: "font-medium text-ink-700 hover:text-brand-700" %>
        <%= button_to t("operators.nav.sign_out"), destroy_operator_session_path, method: :delete,
              class: "font-medium text-ink-700 hover:text-brand-700 underline-offset-2 hover:underline bg-transparent p-0" %>
      <% end %>
      <span aria-hidden="true" class="text-ink-300">|</span>
      <%= link_to "PT", url_for(locale: "pt-BR"), lang: "pt-BR", class: "font-medium hover:text-brand-700" %>
      <%= link_to "EN", url_for(locale: "en"), lang: "en", class: "font-medium hover:text-brand-700" %>
    </nav>
  </div>
</header>
