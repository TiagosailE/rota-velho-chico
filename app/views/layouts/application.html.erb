<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Rota Velho Chico" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rota Velho Chico">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <%# Leaflet.js e pinado via importmap (vendor/javascript/leaflet.js), mas
        a folha de estilo nao passa pelo importmap -- so lida com JS. Vem do
        mesmo CDN oficial do quick start do Leaflet, com SRI, igual as fontes
        acima ja vem do Google Fonts por CDN. %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col">
    <header class="border-b border-ink-200 bg-white/90 backdrop-blur sticky top-0 z-10">
      <div class="container mx-auto px-5 py-4 flex flex-wrap items-center justify-between gap-3">
        <%= link_to tours_path, class: "font-display text-xl font-semibold text-ink-900 hover:text-brand-700 transition-colors" do %>
          Rota Velho Chico
        <% end %>

        <nav class="text-sm flex items-center gap-4 text-ink-600">
          <%= link_to t("layout.nav.tours"), tours_path, class: "font-medium text-ink-700 hover:text-brand-700" %>
          <%= link_to t("layout.nav.my_booking"), new_booking_lookup_path, class: "font-medium text-ink-700 hover:text-brand-700" %>

          <%# Operador ja autenticado precisa de acesso rapido ao painel --
              isso continua no topo. Quem nao esta logado nao ve "Area do
              operador" aqui: esse link vive so no rodape, pro visitante nao
              confundir a ferramenta do operador com o site publico. %>
          <% if operator_signed_in? %>
            <span aria-hidden="true" class="text-ink-300">|</span>
            <span class="hidden sm:inline"><%= t("operators.nav.signed_in_as", name: current_operator.name) %></span>
            <%= link_to t("operators.nav.panel"), operators_root_path, class: "font-medium text-ink-700 hover:text-brand-700" %>
            <%= button_to t("operators.nav.sign_out"), destroy_operator_session_path, method: :delete,
                  class: "font-medium text-ink-700 hover:text-brand-700 underline-offset-2 hover:underline bg-transparent p-0" %>
          <% end %>
          <span aria-hidden="true" class="text-ink-300">|</span>
          <%= link_to "PT", url_for(locale: "pt-BR"), lang: "pt-BR", class: "font-medium hover:text-brand-700" %>
          <%= link_to "EN", url_for(locale: "en"), lang: "en", class: "font-medium hover:text-brand-700" %>
        </nav>
      </div>
    </header>

    <main class="container mx-auto px-5 py-8 flex-1 w-full flex flex-col">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="border-t border-ink-200 bg-white mt-16">
      <div class="container mx-auto px-5 py-8 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="font-display text-base font-semibold text-ink-900">Rota Velho Chico</p>
          <p class="text-xs text-ink-500 mt-1"><%= t("layout.footer.tagline") %></p>
          <p class="text-xs text-ink-400 mt-4 sm:max-w-md"><%= t("layout.footer.disclaimer") %></p>
        </div>

        <%# Link discreto, no padrao de rodape de marketplace (Booking/
            Airbnb tem o equivalente "Torne-se parceiro") -- sem credencial
            nem qualquer mencao a demonstracao/portfolio. %>
        <%= link_to t("operators.nav.sign_in"), new_operator_session_path,
              class: "text-xs font-medium text-ink-500 hover:text-brand-700 whitespace-nowrap" %>
      </div>
    </footer>
  </body>
</html>
