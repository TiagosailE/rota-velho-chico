<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Rota Velho Chico" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rota Velho Chico">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <%# Leaflet.js e pinado via importmap (vendor/javascript/leaflet.js), mas
        a folha de estilo nao passa pelo importmap -- so lida com JS. Vem do
        mesmo CDN oficial do quick start do Leaflet, com SRI, igual as fontes
        acima ja vem do Google Fonts por CDN. %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col">
    <%# @operator_panel so existe nas paginas autenticadas do painel
        (Operators::BaseController) -- login/recuperacao de senha do
        operador continuam com o header publico, porque nelas a sessao
        ainda nao existe. %>
    <%= render(@operator_panel ? "layouts/operator_header" : "layouts/public_header") %>

    <main class="container mx-auto px-5 py-8 flex-1 w-full flex flex-col">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="border-t border-ink-200 bg-white mt-16">
      <div class="container mx-auto px-5 py-8 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="font-display text-base font-semibold text-ink-900">Rota Velho Chico</p>
          <p class="text-xs text-ink-500 mt-1"><%= t("layout.footer.tagline") %></p>
          <p class="text-xs text-ink-400 mt-4 sm:max-w-md"><%= t("layout.footer.disclaimer") %></p>
        </div>

        <%# Link discreto, no padrao de rodape de marketplace (Booking/
            Airbnb tem o equivalente "Torne-se parceiro") -- sem credencial
            nem qualquer mencao a demonstracao/portfolio. %>
        <%= link_to t("operators.nav.sign_in"), new_operator_session_path,
              class: "text-xs font-medium text-ink-500 hover:text-brand-700 whitespace-nowrap" %>
      </div>
    </footer>
  </body>
</html>
