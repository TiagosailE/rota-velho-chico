<div class="w-full">
  <%= link_to t("tours.show.back"), tours_path %>

  <span class="text-xs uppercase tracking-wide"><%= t("tours.categories.#{@tour.category}") %></span>
  <h1 class="text-2xl font-bold mb-2"><%= @tour.title %></h1>
  <p class="text-sm mb-4"><%= t("tours.show.operated_by", name: @tour.operator.name) %></p>

  <p class="mb-4"><%= @tour.description %></p>

  <dl class="grid gap-2 mb-8">
    <div>
      <dt class="inline font-medium"><%= t("tours.show.meeting_point") %>:</dt>
      <dd class="inline"><%= @tour.meeting_point %></dd>
    </div>
    <div>
      <dt class="inline font-medium"><%= t("tours.show.duration") %>:</dt>
      <dd class="inline"><%= format_duration(@tour.duration_minutes) %></dd>
    </div>
    <div>
      <dt class="inline font-medium"><%= t("tours.show.price") %>:</dt>
      <dd class="inline"><%= format_price_cents(@tour.base_price_cents) %></dd>
    </div>
    <% if @tour.min_age.positive? %>
      <div>
        <dd><%= t("tours.show.min_age", age: @tour.min_age) %></dd>
      </div>
    <% end %>
  </dl>

  <h2 class="text-lg font-semibold mb-2"><%= t("tours.show.calendar_title") %></h2>

  <%= turbo_frame_tag "availability_calendar" do %>
    <div class="flex justify-between items-center mb-2">
      <%= link_to "‹", tour_path(@tour.slug, month: @month.prev_month.strftime("%Y-%m")) %>
      <strong><%= l(@month, format: "%B %Y") %></strong>
      <%= link_to "›", tour_path(@tour.slug, month: @month.next_month.strftime("%Y-%m")) %>
    </div>

    <table class="w-full text-center border-collapse">
      <thead>
        <tr>
          <% I18n.t("date.abbr_day_names").each do |day_name| %>
            <th class="text-xs font-normal"><%= day_name %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% calendar_weeks(@month).each do |week| %>
          <tr>
            <% week.each do |day| %>
              <td class="border align-top p-1">
                <% if day %>
                  <div class="text-xs"><%= day.day %></div>
                  <% (@departures_by_date[day] || []).each do |departure| %>
                    <div class="text-xs">
                      <%= departure.starts_at.strftime("%H:%M") %>
                      &mdash;
                      <%= t("tours.show.seats_available", count: departure.capacity - departure.seats_taken) %>
                    </div>
                  <% end %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @departures_by_date.empty? %>
      <p><%= t("tours.show.no_departures") %></p>
    <% end %>
  <% end %>
</div>
