<%# Capa do passeio, com o placeholder para quem ainda nao tem foto. Existe
    como partial porque card e pagina de detalhe pedem variantes diferentes
    da mesma regra de "primeira foto, senao placeholder". %>
<% photo = tour.cover_photo %>
<% if photo %>
  <%= image_tag photo.image.variant(variant), class: css,
        alt: photo.alt_text.presence || tour.title, loading: "lazy" %>
<% else %>
  <div class="<%= css %> bg-stone-100 flex items-center justify-center" role="img"
       aria-label="<%= t("tours.cover.placeholder", title: tour.title) %>">
    <span class="text-stone-400 text-sm"><%= t("tours.cover.no_photo") %></span>
  </div>
<% end %>
