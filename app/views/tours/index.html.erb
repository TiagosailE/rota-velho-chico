<% content_for(:title) { t("tours.index.title") } %>
<div class="w-full">
  <div class="-mx-5 -mt-8 px-5 pt-14 pb-24 mb-[-64px]
              bg-gradient-to-br from-orange-900 via-orange-800 to-stone-900 text-white">
    <div class="max-w-2xl">
      <h1 class="text-3xl sm:text-4xl font-display font-semibold mb-3"><%= t("tours.index.hero.title") %></h1>
      <p class="text-orange-50/90 text-lg mb-4"><%= t("tours.index.hero.subtitle") %></p>
      <%= link_to t("booking_lookups.new.link"), new_booking_lookup_path, class: "text-sm font-medium text-white hover:text-orange-100 underline underline-offset-2" %>
    </div>
  </div>

  <%= form_with url: tours_path, method: :get,
        class: "relative card p-5 mb-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:items-end" do |f| %>
    <div>
      <%= f.label :category, t("tours.index.filter.category"), class: "field-label" %>
      <%= f.select :category,
            Tour.categories.keys.map { |key| [ t("tours.categories.#{key}"), key ] },
            { include_blank: t("tours.index.filter.all_categories"), selected: @category },
            class: "field-input" %>
    </div>

    <div>
      <%= f.label :date, t("tours.index.filter.date"), class: "field-label" %>
      <%= f.date_field :date, value: @date, class: "field-input" %>
    </div>

    <div>
      <%= f.label :min_price, t("tours.index.filter.min_price"), class: "field-label" %>
      <%= f.number_field :min_price, value: @min_price, min: 0, class: "field-input" %>
    </div>

    <div>
      <%= f.label :max_price, t("tours.index.filter.max_price"), class: "field-label" %>
      <%= f.number_field :max_price, value: @max_price, min: 0, class: "field-input" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit t("tours.index.filter.submit"), class: "btn btn-primary" %>
      <%= link_to t("tours.index.filter.clear"), tours_path, class: "btn btn-secondary" %>
    </div>
  <% end %>

  <% if @tours.empty? %>
    <p class="text-stone-500"><%= t("tours.index.empty") %></p>
  <% else %>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @tours.each do |tour| %>
        <%= link_to tour_path(tour.slug), class: "card card-hover overflow-hidden flex flex-col" do %>
          <div class="relative">
            <%= render "tours/cover", tour: tour, variant: :card, css: "w-full aspect-[4/3] object-cover" %>
            <span class="badge badge-category absolute top-3 left-3 bg-white/90 text-orange-800 shadow-sm">
              <%= t("tours.categories.#{tour.category}") %>
            </span>
          </div>

          <div class="p-5 flex flex-col flex-1">
          <h2 class="text-lg font-display font-semibold text-stone-900 mb-1"><%= tour.title %></h2>
          <% if (rating = tour.average_rating) %>
            <p class="text-sm text-amber-600 mb-1">
              <%= t("tours.index.card.rating", rating: rating, count: tour.reviews.count) %>
            </p>
          <% end %>
          <p class="text-sm text-stone-500 mb-4">
            <%= t("tours.index.card.duration_label") %>: <%= format_duration(tour.duration_minutes) %>
          </p>
          <div class="mt-auto flex items-center justify-between pt-3 border-t border-stone-100">
            <span class="text-lg font-semibold text-stone-900"><%= format_price_cents(tour.base_price_cents) %></span>
            <span class="btn-link"><%= t("tours.index.card.details") %></span>
          </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
