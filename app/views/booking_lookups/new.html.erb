<div class="w-full max-w-sm mx-auto">
  <h1 class="text-2xl sm:text-3xl font-semibold text-stone-900 mb-6"><%= t("booking_lookups.new.title") %></h1>

  <%= form_with url: booking_lookup_path, method: :post, class: "card p-6 grid gap-5" do |f| %>
    <div>
      <%= f.label :code, t("booking_lookups.new.code"), class: "field-label" %>
      <%= f.text_field :code, required: true, class: "field-input" %>
    </div>

    <div>
      <%= f.label :email, t("booking_lookups.new.email"), class: "field-label" %>
      <%= f.email_field :email, required: true, class: "field-input" %>
    </div>

    <%= f.submit t("booking_lookups.new.submit"), class: "btn btn-primary w-full" %>
  <% end %>
</div>
