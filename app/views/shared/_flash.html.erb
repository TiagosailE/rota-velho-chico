<%# Toasts flutuantes, so :notice/:alert -- flash guarda outras chaves de uso
    interno (ex.: :booking_id, passado entre o create e a tela de confirmacao
    sem ir na URL) que nunca deveriam aparecer pro usuario. Iterar flash.each
    direto renderizava qualquer chave como se fosse mensagem; agora so os
    dois tipos reais de mensagem viram toast. %>
<div class="toast-container">
  <% %i[notice alert].each do |type| %>
    <% next if flash[type].blank? %>
    <% dismiss_after_ms = 5000 %>
    <div role="alert" data-controller="toast" data-toast-dismiss-after-value="<%= dismiss_after_ms %>"
         data-action="touchstart->toast#touchStart touchmove->toast#touchMove touchend->toast#touchEnd"
         style="--toast-duration: <%= dismiss_after_ms %>ms"
         class="toast <%= type == :alert ? "toast-error" : "toast-notice" %>">
      <span class="toast-icon" aria-hidden="true">
        <% if type == :alert %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 6a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 6Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
          </svg>
        <% else %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </span>

      <p class="toast-message"><%= flash[type] %></p>

      <button type="button" data-action="toast#dismiss" aria-label="<%= t("layout.toasts.dismiss") %>" class="toast-close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      </button>

      <span class="toast-progress" aria-hidden="true"></span>
    </div>
  <% end %>
</div>
