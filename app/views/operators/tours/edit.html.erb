<div class="w-full">
  <%= link_to t("operators.tours.form.back"), operators_tours_path %>

  <h1 class="text-2xl font-bold mb-6"><%= t("operators.tours.edit.title", title: @tour.title) %></h1>

  <%= render "form", tour: @tour %>

  <h2 class="text-lg font-semibold mt-8 mb-2"><%= t("operators.tours.edit.departures_title") %></h2>

  <%= link_to t("operators.tours.edit.new_departure"), new_operators_tour_departure_path(@tour), class: "block mb-4" %>

  <% if @departures.empty? %>
    <p><%= t("operators.tours.edit.no_departures") %></p>
  <% else %>
    <table class="w-full text-left">
      <thead>
        <tr>
          <th><%= t("operators.departures.form.starts_at") %></th>
          <th><%= t("operators.departures.show.occupancy") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @departures.each do |departure| %>
          <tr>
            <td><%= departure.starts_at.strftime("%d/%m/%Y %H:%M") %></td>
            <td><%= departure.seats_taken %>/<%= departure.capacity %></td>
            <td><%= link_to t("operators.departures.show.link"), operators_tour_departure_path(@tour, departure) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
