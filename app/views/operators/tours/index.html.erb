<div class="w-full">
  <h1 class="text-2xl font-bold mb-6"><%= t("operators.tours.index.title") %></h1>

  <%= link_to t("operators.tours.index.new"), new_operators_tour_path, class: "block mb-4" %>

  <% if @tours.empty? %>
    <p><%= t("operators.tours.index.empty") %></p>
  <% else %>
    <div class="grid gap-4">
      <% @tours.each do |tour| %>
        <div class="border rounded-lg p-4">
          <span class="text-xs uppercase tracking-wide"><%= t("tours.categories.#{tour.category}") %></span>
          <% unless tour.active? %>
            <span class="text-xs text-red-600"><%= t("operators.tours.index.inactive") %></span>
          <% end %>
          <h2 class="text-lg font-semibold"><%= tour.title %></h2>
          <%= link_to t("operators.tours.index.manage"), edit_operators_tour_path(tour) %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
