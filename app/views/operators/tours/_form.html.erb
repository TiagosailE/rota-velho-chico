<%= form_with model: [ :operators, tour ], class: "card p-6 sm:p-8 grid gap-5 max-w-lg mx-auto" do |f| %>
  <% if tour.errors.any? %>
    <div class="alert-error">
      <% tour.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, t("operators.tours.form.title"), class: "field-label" %>
    <%= f.text_field :title, required: true, class: "field-input" %>
  </div>

  <div>
    <%= f.label :slug, t("operators.tours.form.slug"), class: "field-label" %>
    <%= f.text_field :slug, required: true, class: "field-input" %>
  </div>

  <div>
    <%= f.label :description, t("operators.tours.form.description"), class: "field-label" %>
    <%= f.text_area :description, rows: 4, class: "field-input" %>
  </div>

  <div>
    <%= f.label :category, t("operators.tours.form.category"), class: "field-label" %>
    <%= f.select :category, Tour.categories.keys.map { |key| [ t("tours.categories.#{key}"), key ] }, {}, class: "field-input" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :duration_minutes, t("operators.tours.form.duration_minutes"), class: "field-label" %>
      <%= f.number_field :duration_minutes, min: 1, required: true, class: "field-input" %>
    </div>

    <div>
      <%= f.label :base_price_reais, t("operators.tours.form.base_price_reais"), class: "field-label" %>
      <%= f.number_field :base_price_reais, min: 0, step: 0.01, required: true, class: "field-input" %>
    </div>
  </div>

  <div>
    <%= f.label :meeting_point, t("operators.tours.form.meeting_point"), class: "field-label" %>
    <%= f.text_field :meeting_point, required: true, class: "field-input" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :lat, t("operators.tours.form.lat"), class: "field-label" %>
      <%= f.number_field :lat, step: "any", min: -90, max: 90, class: "field-input" %>
    </div>

    <div>
      <%= f.label :lng, t("operators.tours.form.lng"), class: "field-label" %>
      <%= f.number_field :lng, step: "any", min: -180, max: 180, class: "field-input" %>
    </div>
  </div>
  <p class="field-hint -mt-3"><%= t("operators.tours.form.coordinates_hint") %></p>

  <div>
    <%= f.label :min_age, t("operators.tours.form.min_age"), class: "field-label" %>
    <%= f.number_field :min_age, min: 0, class: "field-input max-w-[8rem]" %>
  </div>

  <div class="flex flex-col gap-2 border-t border-stone-100 pt-4">
    <label class="flex items-center gap-2 text-sm text-stone-700">
      <%= f.check_box :includes_lunch %>
      <%= t("operators.tours.form.includes_lunch") %>
    </label>

    <label class="flex items-center gap-2 text-sm text-stone-700">
      <%= f.check_box :active %>
      <%= t("operators.tours.form.active") %>
    </label>
  </div>

  <%= f.submit t("operators.tours.form.submit"), class: "btn btn-primary w-full mt-2" %>
<% end %>
