<%= t("booking_mailer.departure_cancelled.greeting", name: @booking.customer_name) %>

<%= t("booking_mailer.departure_cancelled.body_text",
      tour: @booking.departure.tour.title,
      date: @booking.departure.starts_at.strftime("%d/%m/%Y %H:%M"),
      code: @booking.code) %>

<% if @booking.refunded? %>
<%= t("booking_mailer.departure_cancelled.refunded") %>
<% end %>
