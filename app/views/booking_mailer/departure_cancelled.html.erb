<p><%= t("booking_mailer.departure_cancelled.greeting", name: @booking.customer_name) %></p>

<p>
  <%= t("booking_mailer.departure_cancelled.body_html",
        tour: @booking.departure.tour.title,
        date: @booking.departure.starts_at.strftime("%d/%m/%Y %H:%M"),
        code: @booking.code) %>
</p>

<% if @booking.refunded? %>
  <p><%= t("booking_mailer.departure_cancelled.refunded") %></p>
<% end %>
