<p><%= t("booking_mailer.booking_created.greeting", name: @booking.customer_name) %></p>

<p>
  <%= t("booking_mailer.booking_created.body_html",
        tour: @booking.departure.tour.title,
        date: @booking.departure.starts_at.strftime("%d/%m/%Y %H:%M"),
        code: @booking.code) %>
</p>

<p><%= t("booking_mailer.booking_created.meeting_point", place: @booking.departure.tour.meeting_point) %></p>

<p><%= t("booking_mailer.booking_created.keep_email") %></p>
